# Copy to .env (gitignored) and adjust. Never commit real secrets.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://unveil:unveil@localhost:5432/unveil

# Generate each with: openssl rand -base64 48
SESSION_SECRET=change-me-session-secret-at-least-32-chars
SIGNED_URL_SECRET=change-me-signed-url-secret-at-least-32-chars

# Storage: "local" (private dir outside public/) or "s3" (S3 / Cloudflare R2 compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_REGION=auto
# S3_BUCKET=unveil-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Google OAuth (optional; Google sign-in is disabled when unset)
# Redirect URI to register: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- added in backend/fixes-1 ---
# Signed download link lifetime in seconds (default 86400 = 24h). platform_settings.download_ttl_seconds overrides.
# SIGNED_URL_TTL_SECONDS=86400
# Rate limiting: RATE_LIMIT_ENABLED=0 disables; RATE_LIMIT_STORE=postgres|memory; RATE_LIMIT_<NAME>=max/windowSeconds
# (names: LOGIN_IP LOGIN_EMAIL SIGNUP_IP FORGOT_IP FORGOT_EMAIL RESET_IP DOWNLOAD PREVIEW PUBLIC_LINK SIGNED_URL CHECKOUT)
# RATE_LIMIT_LOGIN_IP=20/900
# Progressive login delays (replace the old lockout; platform_settings.login_delay_* override these). See README "Login delays".
# LOGIN_DELAY_THRESHOLD=5          # failures before the first delay
# LOGIN_DELAY_BASE_SECONDS=1       # first delay, doubles per further failure
# LOGIN_DELAY_CAP_SECONDS=60       # max delay (<= 3600) = the longest an owner ever has to wait
# LOGIN_DELAY_DECAY_SECONDS=900    # failures are forgotten after this long without an attempt
# Number of reverse proxies in front of the app that append to X-Forwarded-For (set correctly in production!)
# TRUSTED_PROXY_HOPS=1
# Email: file (dev; writes .dev-mail/), console, resend, postmark. Required in production.
MAIL_TRANSPORT=file
# MAIL_FROM="Unveil <no-reply@unveil.link>"
# MAIL_DEV_DIR=.dev-mail
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# --- added in payments/abstraction (see README "Payments layer" and PAYMENTS-NOTES.md) ---
# Which processor handles NEW checkouts. Registered: "mock" (default; never works in production). Segpay/CCBill: not implemented yet.
# PAYMENT_PROVIDER=mock
# HMAC-SHA256 key for webhook signatures (>= 32 chars): openssl rand -hex 32. Never commit a real one.
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret-at-least-32-chars
# Max clock skew accepted on a webhook signature timestamp (replay window), seconds.
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Mock processor's fee, percent (platform_settings.processing_fee_percent overrides when set). Spec example: 12.
# MOCK_PROCESSING_FEE_PERCENT=12
# Rate limit for rejected (unauthenticated) webhook deliveries that get logged, per IP:
# RATE_LIMIT_WEBHOOK_REJECTED=60/60
# ONLY for running the repo's e2e against a production build on loopback (scripts/e2e.sh sets it). Needs a localhost/127.0.0.1 APP_URL.
# MOCK_PAYMENTS_LOCAL_BUILD=1
# Platform fee %, processing fee %, hold days (7), minimum payout (2500 cents), chargeback fee live in platform_settings (SQL, no admin UI yet):
#   UPDATE platform_settings SET fee_percent = 10, processing_fee_percent = 12, payout_hold_days = 7, min_payout_cents = 2500, chargeback_fee_cents = 0;
